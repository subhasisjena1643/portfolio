<dialog id="command-guide" aria-labelledby="guide-title">
<header><h2 id="guide-title">Command reference</h2><button type="button" aria-label="Close command reference">Esc ×</button></header>
<section><h3>Piper</h3><dl>
<dt>hi piper · hey piper · hello ai · hello piper</dt><dd>Start a conversation in the terminal. Talk with Piper about the site or whatever’s on your mind.</dd>
<dt>bye · goodbye · quit · exit · back to shell</dt><dd>Leave chat and resume the same shell session.</dd>
</dl></section>
<section><h3>Discoveries</h3><dl>
<dt>Ctrl + Alt + Space</dt><dd>Open the passphrase receiver. On touchscreens, hold the page title for a moment.</dd>
<dt>Receiver sequences</dt><dd>A configured Piper sequence opens the radio. A district sequence takes you to Bengaluru After Hours.</dd>
<dt>Metro tokens</dt><dd>Find three around Market Cross, then visit Pixel Palace for the gold jacket.</dd>
</dl></section>
<section><h3>Terminal</h3><dl>
<dt>ls · dir · Get-ChildItem</dt><dd>List files. Use cd, chdir or Set-Location to change directories.</dd>
<dt>cat · type · Get-Content</dt><dd>Read a file. Use find to search names and paths.</dd>
<dt>pwd · Get-Location · whoami · history</dt><dd>Show the current path, session user or command history.</dd>
<dt>clear · cls · Clear-Host</dt><dd>Clear the scrollback. Ctrl + L also clears it.</dd>
<dt>Tab · ↑ / ↓ · Ctrl + C</dt><dd>Complete a path, recall a command, or cancel the current input.</dd>
<dt>help · Get-Help · exit</dt><dd>Show shell help or return to the matching portfolio page. Swipe horizontally to switch editions.</dd>
</dl></section>
<section><h3>City controls</h3><dl><dt>WASD / arrows · Space · E</dt><dd>Walk, jump, and talk or explore. Use Map to travel directly to a venue.</dd></dl></section>
<section id="guide-owner" hidden><h3>Publishing</h3><p></p></section>
</dialog>
<script>
import {gatePath} from '../data/api-paths';
const guide=document.querySelector<HTMLDialogElement>('#command-guide')!;
const owner=guide.querySelector<HTMLElement>('#guide-owner')!;
let request:AbortController|undefined;
guide.querySelector('button')!.onclick=()=>guide.close();
guide.onclose=()=>{request?.abort();owner.hidden=true;owner.querySelector('p')!.textContent=''};
window.addEventListener('keydown',async event=>{
 if(!(event.code==='Slash'&&(event.ctrlKey||event.metaKey)&&!event.altKey&&!event.shiftKey))return;
 event.preventDefault();
 if(event.repeat)return;
 if(guide.open){guide.close();return}
 guide.showModal();
 request=new AbortController();
 try{
  const response=await fetch(gatePath,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'guide'}),signal:request.signal});
  if(!response.ok)return;
  const data=await response.json();
  if(guide.open&&typeof data.owner==='string'){owner.querySelector('p')!.textContent=data.owner;owner.hidden=false}
 }catch{/* Public reference stays available offline. */}
},true);
</script>
<style>
#command-guide{position:fixed;inset:0;width:min(37rem,calc(100% - 2rem));max-height:78dvh;overflow:auto;overscroll-behavior:contain;border:1px solid #727e71;border-radius:8px;background:#151c1c;color:#ececdd;padding:0 1.35rem 1.2rem;box-shadow:0 1rem 5rem #1118;font:1rem/1.5 system-ui;text-align:left;z-index:99}
#command-guide::backdrop{background:#1118}#command-guide header{background:#151c1c;position:sticky;top:0;display:flex;justify-content:space-between;align-items:center;gap:1rem;border:0;border-bottom:1px solid #58615a;padding:.9rem 0;margin:0;max-width:none;height:auto}
#command-guide h2{font:600 1.32rem/1.3 system-ui;letter-spacing:normal;color:inherit;margin:0}
#command-guide button{background:#2b3732;color:inherit;border:1px solid #67776c;font:.85rem monospace;padding:.45rem .6rem;cursor:pointer}
#command-guide h3{font:600 1.1rem system-ui;letter-spacing:normal;margin:1.2rem 0 .4rem;color:#e3bb97}#command-guide dl{margin:0}#command-guide dt{font:600 .88rem/1.6 monospace;color:#d0e7c5;margin:.75rem 0 .15rem}#command-guide dd{margin:0;color:#d4d8d0}
</style>