---
interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
}

const { title, description, image, noIndex = false } = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/art/atlas-social.png', Astro.site ?? Astro.url);
---
<title>{title}</title>
<meta name="description" content={description} />
{noIndex && <meta name="robots" content="noindex" />}
{canonical && !noIndex && <link rel="canonical" href={canonical.href} />}
<meta property="og:site_name" content="Atlas of Invisible Things" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && !noIndex && <meta property="og:url" content={canonical.href} />}
<meta property="og:image" content={socialImage.href} />
{!image && <meta property="og:image:alt" content="Subhasis Jena, Atlas of Invisible Things, with the personal Atlas mark." />}
<meta name="twitter:card" content="summary_large_image" />
