---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import EntryNavigation from '../../components/EntryNavigation.astro';
import { researchNotes } from '../../data/research';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => researchNotes.map((note) => ({ params: { slug: note.slug }, props: { note } }))) satisfies GetStaticPaths;

const { note } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---
<BaseLayout title={`${note.title} · Research · Subhasis Jena`} description={note.question}>
  <article class="study research-study">
    <a class="study-back" href="/#research">← Research notes</a>
    <header class="study-header">
      <div>
        <p class="eyebrow">{note.category}</p>
        <h1 style={{viewTransitionName: 'research-'+note.slug}}>{note.title}</h1>
        <p class="study-question">{note.question}</p>
        <p>{note.summary}</p>
      </div>
    </header>
    <section class="research-test section-rule" aria-labelledby="test-title">
      <h2 id="test-title">Next experiment</h2>
      <p>{note.test}</p>
    </section>
    <EntryNavigation entries={researchNotes} slug={note.slug} section="research" />
  </article>
</BaseLayout>
