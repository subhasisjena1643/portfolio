---
export const prerender=false;
import {getEntries} from '../data/journal';
const entries=getEntries();
import OpeningPlate from '../components/OpeningPlate.astro';

import WorkListing from '../components/WorkListing.astro';
import { getVisibleWork } from '../data/work';
import { magneticAssembly, researchNotes } from '../data/research';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getVisibleWork();
const classroom = projects.find(p => p.slug === 'classanalyzer');
const studio = projects.find(p => p.slug === 'mulm-studio');
---
<BaseLayout title="Subhasis Jena · Atlas of Invisible Things" description="Subhasis Jena designs interfaces for things that are hard to see. Explore ClassAnalyzer, MuLM Studio, and research notes.">
  <section class="cover" aria-labelledby="name">
    <div class="cover-heading">
      <h1 id="name">Subhasis Jena</h1>
      <div class="cover-intro">
        <p class="cover-statement">I design interfaces for things that are hard to see.</p>
        <p class="cover-context">A classroom session, a model’s data flow, or the evidence behind a system failure.</p>
        {projects.length > 0 && <a class="cover-work-link" href="#work">View selected work</a>}
      </div>
    </div>
    <OpeningPlate {classroom} {studio} research={magneticAssembly} />
  </section>
  <WorkListing projects={projects} />
  <section id="research" class="chapters section-rule" aria-labelledby="research-title">
    <div class="section-heading"><h2 id="research-title">Research notes</h2></div>
    <ul class="research-list">
      {researchNotes.map((note) => (
        <li>
          <p class="eyebrow">{note.category}</p>
          <h3 style={{viewTransitionName: 'research-'+note.slug}}><a href={`/research/${note.slug}/`}>{note.title}</a></h3>
          <p>{note.question}</p>
          <p class="chapter-summary">{note.test}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="notebook section-rule" aria-label="Journal"><div><p class="imprint">Journal</p><a href="/journal/">All entries</a></div>
    {entries[0] && <article><p class="eyebrow">{entries[0].category} · <time>{entries[0].date}</time></p><h2><a href={`/journal/${entries[0].slug}/`} style={{ viewTransitionName: 'entry-'+entries[0].slug }}>{entries[0].title}</a></h2><p>{entries[0].excerpt}</p></article>}</section>
  <section id="about" class="home-about section-rule" aria-labelledby="about-title">
    <h2 id="about-title">About</h2>
    <div>
      <p>I’m based in Bengaluru. My background in electronics and communication informs how I work across interfaces, model tooling and systems diagnostics.</p>
      <a href="/about/">More about me <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
