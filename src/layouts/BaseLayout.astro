---
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/atlas.css';
import '../styles/cover.css';
import Receiver from '../components/Receiver.astro';
import EditionSlide from '../components/EditionSlide.astro';
import Rift from '../components/Rift.astro';
import BrandMark from '../components/BrandMark.astro';
import PageMeta from '../components/PageMeta.astro';
import { contacts } from '../data/contacts';

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
  socialImage?: string;
}

const { title, description, noIndex = false, socialImage } = Astro.props;
const localPreview = import.meta.env.DEV;
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '';
const terminalDestination = '/terminal/?from=' + encodeURIComponent(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <link rel="alternate" type="text/plain" href="/atlas.txt" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <PageMeta {title} {description} image={socialImage} noIndex={localPreview || noIndex} />
    <slot name="meta" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', 'shell', { 'atlas-masthead': isHome }]}>
      <a class="site-name" href="/"><BrandMark /><span>{isHome ? 'Atlas of Invisible Things' : 'Subhasis Jena'}</span></a>
      <nav aria-label="Main navigation">
        <a href="/work/" aria-current={path === '/work' ? 'page' : undefined}>Work</a>
        <a href="/#research">Research</a>
        {!isHome && <a href="/journal/">Journal</a>}
        <a href="/about/" aria-current={path === '/about' ? 'page' : undefined}>About</a>
        {!isHome && <a href="#contact">Say hello</a>}
        {!isHome && !noIndex && <EditionSlide destination={terminalDestination} />}
      </nav>
    </header>

    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer id="contact" class:list={['site-footer', { 'atlas-closing': isHome }]} data-surface="dark">
      <div class="shell footer-inner">
        <div>
          {isHome ? <><BrandMark /><h2>Subhasis Jena</h2><p>Bengaluru</p></> : <><h2>Say hello</h2><p>Subhasis Jena · Bengaluru</p></>}
          <ul class="contact-links">
            {isHome && <><li><a href="/work/">Work</a></li><li><a href="/about/#resume">Résumé</a></li></>}
            {contacts.map(({ label, href }) => <li><a href={href}>{isHome && label === 'LinkedIn' ? 'Contact on LinkedIn' : label} <span aria-hidden="true">↗</span></a></li>)}
            {isHome && !noIndex && <li><EditionSlide destination={terminalDestination} /></li>}
          </ul>
        </div>
        <div class="signal-end"><Rift /><Receiver /></div>
      </div>
    </footer>
    <script src="../scripts/editorial-scroll.ts"></script>
  </body>
</html>
<style>
  .site-footer::before {
    content: '';
    display: block;
    height: 1.25rem;
    background: var(--palette-canvas);
    border-top: 1px solid var(--palette-rule);
  }
  .atlas-closing h2 { font-size: clamp(3.2rem, 8vw, 8rem); }
  .atlas-closing .brand-mark { height: clamp(2rem, 4vw, 3.5rem); margin-bottom: .85rem; }
  .atlas-closing .contact-links { margin-top: 1rem; }
</style>
